# ---------------------------------------------------------------------------
# MPLADS AI Monitor — environment configuration
# Copy to .env and fill in. Never commit the filled file.
# ---------------------------------------------------------------------------

# Warehouse. SQLite is the zero-infrastructure default; PostgreSQL is recommended
# for a shared deployment.
# MPLADS_DB_URL=postgresql+psycopg://mplads:change-me@postgres:5432/mplads
MPLADS_DB_URL=sqlite:///data/processed/mplads.db

# Alternate config file (thresholds, weights, bands)
# MPLADS_CONFIG=/app/config/config.yaml

# Logging: DEBUG | INFO | WARNING | ERROR
MPLADS_LOG_LEVEL=INFO

# --- API security ----------------------------------------------------------
# Three roles. Replace every value before deploying.
MPLADS_API_KEY_ADMIN=change-me-admin
MPLADS_API_KEY_ANALYST=change-me-analyst
MPLADS_API_KEY_VIEWER=change-me-viewer
# Set to 1 ONLY for local development / tests.
MPLADS_AUTH_DISABLED=0
# Comma-separated allowed origins for the dashboard
MPLADS_CORS=http://localhost:5173

# --- Optional LLM for the analytics assistant -------------------------------
# Without a key the assistant still works: it answers through reviewed,
# parameterised analytics tools. With a key it may also generate SELECT
# statements, which are validated by the SQL guard before execution.
# MPLADS_LLM_PROVIDER=anthropic
# MPLADS_LLM_API_KEY=
# MPLADS_LLM_MODEL=claude-sonnet-4-5
